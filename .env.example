# Salin file ini menjadi .env lalu isi. JANGAN commit .env.
# Rahasia untuk melindungi endpoint /api/tick, /api/snapshot, /api/kill
CRON_SECRET=isi_string_acak_panjang_di_sini

# Storage persisten: Upstash Redis (gratis, lewat Vercel Marketplace)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Kill switch lewat environment variable (1 = aktif). Alternatif: /api/kill
KILL_SWITCH=0
